{
  "name": "cue",
  "version": "0.2.1",
  "description": "Real-time AI interview copilot — listens, detects the interviewer's question, and streams an answer in under a second.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": "Alok",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --experimental-websocket scripts/bench-latency.mjs",
    "probe": "node --experimental-websocket scripts/probe-providers.mjs",
    "package:win": "npm run build && node scripts/build-installer.mjs",
    "package:dir": "npm run build && node scripts/build-installer.mjs --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
