# ---------------------------------------------------------------------------
# Cue — copy to `.env` and fill in. Only the providers you actually select need
# to be present. Keys entered through the Settings UI are stored encrypted with
# the OS keychain instead and take precedence over anything here, so `.env` is
# a development convenience rather than the production path.
# ---------------------------------------------------------------------------

# Speech-to-text. Required — this is what listens to the interview.
# Flux (`/v2/listen`) is the model the pipeline is built around: it reports
# end-of-turn natively, including an early "eager" signal we generate against.
DEEPGRAM_API_KEY=

# --- LLM providers (pick one; the rest are optional alternates) -------------

# Default. Measured ~210 ms to first token warm on llama-3.3-70b-versatile.
GROQ_API_KEY=

# Widest model selection, incl. Claude and Gemini. Note the free tier is
# rate-limited and unsuitable as a primary.
OPENROUTER_API_KEY=

OPENAI_API_KEY=

# The only provider here with explicit prompt caching, which the adapter uses
# for the stable candidate-profile block.
ANTHROPIC_API_KEY=

# debug | info | warn | error
LOG_LEVEL=info
